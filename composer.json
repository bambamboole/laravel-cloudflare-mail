{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "bambamboole/laravel-cloudflare-mail",
    "description": "Cloudflare Email Service transport for Laravel.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "mail",
        "mailer",
        "transport",
        "cloudflare",
        "email",
        "cloudflare-email-service"
    ],
    "authors": [
        {
            "name": "Manuel Christlieb",
            "email": "manuel@christlieb.eu"
        },
        {
            "name": "Mateus Junges",
            "email": "mateus@junges.dev"
        }
    ],
    "require": {
        "php": "^8.4",
        "illuminate/http": "^13.0",
        "illuminate/mail": "^13.0",
        "illuminate/support": "^13.0",
        "symfony/mailer": "^8.0"
    },
    "require-dev": {
        "bambamboole/extended-testbench": "^0.6.1",
        "larastan/larastan": "^3.10",
        "laravel/pint": "^1.29",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0",
        "pestphp/pest-plugin-phpstan": "^5.0",
        "rector/rector": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Bambamboole\\CloudflareMail\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Bambamboole\\CloudflareMail\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "check": [
            "pint --test",
            "phpstan analyse",
            "rector --dry-run",
            "@test"
        ],
        "lint": "pint --format agent",
        "stan": "phpstan analyse",
        "test:lint": "./vendor/bin/pint --test",
        "test": "pest",
        "refactor": "rector",
        "post-autoload-dump": [
            "@php vendor/bin/testbench package:purge-skeleton --ansi",
            "@php vendor/bin/testbench package:discover --ansi"
        ],
        "post-install-cmd": [
            "@boost:refresh"
        ],
        "post-update-cmd": [
            "@boost:refresh"
        ],
        "boost:refresh": "[ -n \"$CI\" ] || [ ! -f vendor/bin/testbench ] || [ ! -f boost.json ] || { [ -f package.json ] && [ ! -d node_modules ]; } || vendor/bin/testbench boost:update --no-interaction || true",
        "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Bambamboole\\CloudflareMail\\CloudflareMailServiceProvider"
            ]
        },
        "extended-testbench": {
            "check-ignore": [
                "phpstan.neon.dist"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
